WEB_PORT=3000
API_PORT=8080

# Channel Manager — environment variables (template)
#
# Copy this file to `.env` and fill in real values for local development.
# `.env` is gitignored. Never commit secrets.

# ── Database ─────────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=channel
DB_USER=postgres
DB_PASSWORD=***
DB_SSLMODE=disable
# Convenience: full DSN form for tools that prefer URL-style.
DATABASE_URL=postgres://postgres:***@localhost:5432/channel?sslmode=disable

# Runtime application role. Used by long-running services so RLS
# policies are actually enforced. Migration tooling continues to use
# DB_USER/DB_PASSWORD above. Defaults match migrations/tenancy/0004.
APP_DB_USER=app
APP_DB_PASSWORD=app_dev

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# ── NATS ─────────────────────────────────────────────────────────────────────
NATS_URL=nats://localhost:4222

# ── Auth (WorkOS) ────────────────────────────────────────────────────────────
# Source of truth for identity. Backend verifies JWTs against the JWKS URL.
AUTH_PROVIDER=workos
AUTH_ISSUER=https://api.workos.com/user_management/<WORKOS_CLIENT_ID>
AUTH_JWKS_URL=https://api.workos.com/sso/jwks/<WORKOS_CLIENT_ID>

# WorkOS server-side credentials.
#   API Keys page → Secret key  (sk_…)
#   Configuration page → Client ID (client_…)
WORKOS_API_KEY=
WORKOS_CLIENT_ID=
# 32+ byte random string. Generate with: openssl rand -base64 32
WORKOS_COOKIE_PASSWORD=
WORKOS_REDIRECT_URI=https://api.cm.local/auth/callback
NEXT_PUBLIC_API_URL=https://api.cm.local
API_URL=https://api.cm.local
DASHBOARD_URL=https://cm.local
# Required for this tenant-scoped dashboard. Social OAuth sessions otherwise
# may be issued without an org_id and will be rejected by protected routes.
WORKOS_ORG_ID=org_your_organization_id
# Signing secret for WorkOS webhook deliveries. Found in the WorkOS
# dashboard under Webhooks → Signing Secret. Required to verify
# incoming webhook payloads via HMAC-SHA256.
WORKOS_WEBHOOK_SECRET=

# ── PMS (MyPMS booking engine webhooks — docs/PMS_API_REFERENCE.md §1) ─────
# Per-connection credentials (base_url, bearer_token) are stored when you call
# PmsService/ConnectPms. Optional default base URL for local dev tooling.
# Where this Channel Manager reaches the PMS when a connection has no stored
# credentials. A DEFAULT, not an override: per-tenant credentials registered
# through the integration API take precedence, so these cannot silently redirect
# one organization's traffic to another organization's PMS. With neither set and
# nothing stored, credential resolution errors rather than guessing.
#
# Origin only — the MyPMS client appends /api/webhooks/... itself.
PMS_BASE_URL=https://pms.local
PMS_BEARER_TOKEN=

# ── PMS inbound auth ─────────────────────────────────────────────────────────
#
# Three ways a machine caller can authenticate, tried in this order:
#
#   1. A bundled tenant's PMS presents a short-lived Ed25519 assertion. Nothing is
#      stored on either side and the tenant is created on first contact.
#   2. A standalone customer presents a `cm_live_…` key from
#      POST /admin/integration-keys (WorkOS owner/admin session).
#   3. The dev-only static token map below.

# JSON map of key id → Ed25519 PUBLIC key (PEM or base64) used to verify PMS
# assertions. Generate with, in pms-app: npx tsx scripts/generate-cm-keypair.ts
# A map rather than one key so a replacement can be published here BEFORE the PMS
# starts signing with it — that overlap is what makes rotation possible without
# restarting both services at the same instant.
# Example: CM_PMS_PUBLIC_KEYS='{"pms-1a2b3c4d":"-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"}'
CM_PMS_PUBLIC_KEYS=

# Expected `iss` / `aud` on those assertions. Must match the PMS's CM_JWT_ISSUER
# and CM_JWT_AUDIENCE. Empty disables the respective check.
CM_PMS_JWT_ISSUER=pms
CM_PMS_JWT_AUDIENCE=channel-manager

# Clock drift tolerated when validating assertion lifetimes. They live ~90s, so
# with no leeway a few seconds of drift between two containers rejects valid
# tokens intermittently — which presents as flaky 401s under load rather than as
# a misconfiguration.
CM_PMS_JWT_CLOCK_SKEW=30s

# ── Dev-only static tokens ───────────────────────────────────────────────────
#
# JSON map of local org UUID → token. This turns a static string into a tenant
# with NO database validation: whatever UUID appears here becomes the RLS org,
# whether or not that organization exists. No expiry, no revocation, no scopes,
# plaintext in the environment.
#
# Ignored unless CM_ALLOW_DEV_INTEGRATION_SECRETS=true, so shipping a stale value
# to a deployed environment is inert rather than a working credential. Never set
# that flag anywhere but a developer machine.
# Example: CM_INTEGRATION_SECRETS='{"<org-uuid>":"dev-pms-integration-token"}'
CM_INTEGRATION_SECRETS=
CM_ALLOW_DEV_INTEGRATION_SECRETS=false

# ── Observability (filled in Phase 6) ────────────────────────────────────────
OTEL_SERVICE_NAME=channel-manager
OTEL_EXPORTER_OTLP_ENDPOINT=localhost:4317
SENTRY_DSN=
