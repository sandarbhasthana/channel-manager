# Channel Manager — environment variables (template)
#
# Copy this file to `.env` and fill in real values for local development.
# `.env` is gitignored. Never commit secrets.

# ── Database ─────────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=channel
DB_USER=postgres
DB_PASSWORD=***
DB_SSLMODE=disable
# Convenience: full DSN form for tools that prefer URL-style.
DATABASE_URL=postgres://postgres:***@localhost:5432/channel?sslmode=disable

# Runtime application role. Used by long-running services so RLS
# policies are actually enforced. Migration tooling continues to use
# DB_USER/DB_PASSWORD above. Defaults match migrations/tenancy/0004.
APP_DB_USER=app
APP_DB_PASSWORD=app_dev

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# ── NATS ─────────────────────────────────────────────────────────────────────
NATS_URL=nats://localhost:4222

# ── Auth (WorkOS) ────────────────────────────────────────────────────────────
# Source of truth for identity. Backend verifies JWTs against the JWKS URL.
AUTH_PROVIDER=workos
AUTH_ISSUER=https://api.workos.com
AUTH_JWKS_URL=https://api.workos.com/sso/jwks/<WORKOS_CLIENT_ID>

# WorkOS server-side credentials.
#   API Keys page → Secret key  (sk_…)
#   Configuration page → Client ID (client_…)
WORKOS_API_KEY=
WORKOS_CLIENT_ID=
# 32+ byte random string. Generate with: openssl rand -base64 32
WORKOS_COOKIE_PASSWORD=
WORKOS_REDIRECT_URI=http://localhost:8080/auth/callback
# Signing secret for WorkOS webhook deliveries. Found in the WorkOS
# dashboard under Webhooks → Signing Secret. Required to verify
# incoming webhook payloads via HMAC-SHA256.
WORKOS_WEBHOOK_SECRET=

# ── Observability (filled in Phase 6) ────────────────────────────────────────
OTEL_SERVICE_NAME=channel-manager
OTEL_EXPORTER_OTLP_ENDPOINT=localhost:4317
SENTRY_DSN=
